---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Kidz 4 A Cure. We're based in Davie, FL and love hearing from volunteers, donors, and community partners."
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-brand-red-dark to-brand-red py-20 sm:py-24 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-brand-gold blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-2 mb-6">
        <Icon name="mdi:email-outline" class="w-4 h-4 text-brand-gold-light" />
        <span class="text-sm text-white/90">Reach Out</span>
      </div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-tight mb-6">
        Contact Us
      </h1>
      <p class="text-lg sm:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto">
        We're a small team and we genuinely love hearing from our community. Don't hesitate to reach out.
      </p>
    </div>
  </section>

  <!-- Contact Info + Form -->
  <section class="bg-white py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Contact Info -->
        <div>
          <SectionHeader title="Get In Touch" subtitle="We'd love to hear from you." align="left" />

          <div class="space-y-6">
            <div class="flex items-start gap-4 p-5 bg-neutral-50 rounded-2xl">
              <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:map-marker" class="w-5 h-5 text-brand-red" />
              </div>
              <div>
                <div class="font-display font-bold text-neutral-900 mb-1">Address</div>
                <p class="text-neutral-600 text-sm leading-relaxed">
                  6220 SW 38th Street<br />
                  Davie, FL 33314
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-neutral-50 rounded-2xl">
              <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:phone" class="w-5 h-5 text-brand-red" />
              </div>
              <div>
                <div class="font-display font-bold text-neutral-900 mb-1">Phone</div>
                <a href="tel:7542449569" class="text-neutral-600 text-sm hover:text-brand-red transition-colors">
                  754-244-9569
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-neutral-50 rounded-2xl">
              <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:email-outline" class="w-5 h-5 text-brand-red" />
              </div>
              <div>
                <div class="font-display font-bold text-neutral-900 mb-1">Email</div>
                <a href="mailto:kidz4acure1993@gmail.com" class="text-neutral-600 text-sm hover:text-brand-red transition-colors break-all">
                  kidz4acure1993@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-neutral-50 rounded-2xl">
              <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:clock-outline" class="w-5 h-5 text-brand-red" />
              </div>
              <div>
                <div class="font-display font-bold text-neutral-900 mb-1">Response Time</div>
                <p class="text-neutral-600 text-sm">
                  We aim to respond to all inquiries within 2–3 business days.
                </p>
              </div>
            </div>
          </div>

          <!-- Map Placeholder -->
          <div class="mt-8 rounded-2xl overflow-hidden border border-neutral-200 h-56 bg-neutral-100 flex items-center justify-center">
            <div class="text-center text-neutral-400">
              <Icon name="mdi:map" class="w-12 h-12 mx-auto mb-2" />
              <p class="text-sm font-medium">Davie, FL 33314</p>
              <a
                href="https://www.google.com/maps/search/6220+SW+38th+Street+Davie+FL+33314"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-brand-red hover:underline mt-1 block"
              >
                View on Google Maps
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <div class="bg-neutral-50 rounded-2xl p-8 border border-neutral-200">
            <h2 class="font-display font-bold text-2xl text-neutral-900 mb-2">Send Us a Message</h2>
            <p class="text-neutral-500 text-sm mb-7">
              Whether you're curious about volunteering, donating, or just want to say hello — we're all ears.
            </p>

            <form
              action="mailto:kidz4acure1993@gmail.com"
              method="POST"
              enctype="text/plain"
              class="space-y-5"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5" for="contact-name">Full Name</label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    class="w-full border border-neutral-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red bg-white"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5" for="contact-email">Email</label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    class="w-full border border-neutral-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red bg-white"
                    placeholder="your@email.com"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5" for="contact-subject">Subject</label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  class="w-full border border-neutral-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red bg-white"
                  placeholder="What's this about?"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5" for="contact-message">Message</label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  required
                  class="w-full border border-neutral-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red bg-white resize-none"
                  placeholder="Your message..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-brand-red text-white font-semibold py-3.5 rounded-full hover:bg-brand-red-dark transition-colors"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Links CTA -->
  <section class="bg-brand-cream py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { href: '/donate', icon: 'mdi:gift-outline', label: 'Make a Donation', desc: 'Give a child the gift of being remembered' },
          { href: '/get-involved', icon: 'mdi:hand-heart-outline', label: 'Get Involved', desc: 'Volunteer, sponsor, or partner with us' },
          { href: '/events', icon: 'mdi:calendar-heart', label: 'Upcoming Events', desc: 'Join us at Operation: Holiday Cheer' },
        ].map(link => (
          <a
            href={link.href}
            class="bg-white rounded-2xl p-5 flex items-start gap-4 border border-neutral-200 hover:border-brand-red hover:shadow-md transition-all group"
          >
            <div class="w-10 h-10 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-brand-red/20 transition-colors">
              <Icon name={link.icon} class="w-5 h-5 text-brand-red" />
            </div>
            <div>
              <div class="font-display font-bold text-neutral-900 text-sm group-hover:text-brand-red transition-colors">{link.label}</div>
              <p class="text-neutral-500 text-xs mt-0.5">{link.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
