---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';

const photos = [
  { caption: 'Children receiving their holiday gifts at Operation: Holiday Cheer 2023', aspect: 'tall' },
  { caption: 'Volunteer team wrapping gifts before the big day', aspect: 'wide' },
  { caption: 'A child opening their personal holiday wish', aspect: 'square' },
  { caption: 'Families gathering at our annual celebration', aspect: 'wide' },
  { caption: 'Our amazing volunteers — the heart of K4AC', aspect: 'square' },
  { caption: 'Gift distribution at Operation: Holiday Cheer', aspect: 'tall' },
  { caption: 'Community members coming together for the holidays', aspect: 'square' },
  { caption: 'Spreading holiday cheer across South Florida', aspect: 'wide' },
  { caption: 'Children dressed in their new holiday outfits', aspect: 'square' },
  { caption: 'The K4AC team at AIDS Walk Broward', aspect: 'tall' },
  { caption: 'Sorting and organizing donations for event day', aspect: 'wide' },
  { caption: 'Every child deserves to feel celebrated', aspect: 'square' },
];
---

<BaseLayout
  title="Gallery"
  description="Photos from Operation: Holiday Cheer and Kidz 4 A Cure community events. See the joy we create together for children and families in South Florida."
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-brand-red-dark to-brand-red py-20 sm:py-24 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-64 h-64 rounded-full bg-brand-gold blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-2 mb-6">
        <Icon name="mdi:image-multiple-outline" class="w-4 h-4 text-brand-gold-light" />
        <span class="text-sm text-white/90">Our Community</span>
      </div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-tight mb-6">
        Gallery
      </h1>
      <p class="text-lg sm:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto">
        Every photo tells a story of joy, community, and the lasting impact of a single act of generosity.
      </p>
    </div>
  </section>

  <!-- Gallery Intro -->
  <section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-neutral-600 text-lg leading-relaxed">
        Over 20 years of Operation: Holiday Cheer has given us thousands of precious memories. Browse photos from our events, our volunteers, and the amazing children and families who inspire everything we do.
      </p>
      <p class="text-neutral-500 text-sm mt-3">
        Have photos to share? <a href="mailto:kidz4acure1993@gmail.com?subject=Gallery Photo Submission" class="text-brand-red hover:underline font-medium">Send them our way</a>
      </p>
    </div>
  </section>

  <!-- Photo Grid -->
  <section class="bg-neutral-50 py-12 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4"
        x-data="{}"
      >
        {photos.map((photo, index) => (
          <div
            class="break-inside-avoid relative group overflow-hidden rounded-2xl bg-neutral-200 cursor-pointer"
            x-data="{ hovered: false }"
            @mouseenter="hovered = true"
            @mouseleave="hovered = false"
          >
            <!-- Placeholder image tile -->
            <div
              class={`w-full flex items-center justify-center bg-gradient-to-br ${
                index % 4 === 0 ? 'from-neutral-300 to-neutral-400' :
                index % 4 === 1 ? 'from-neutral-200 to-neutral-300' :
                index % 4 === 2 ? 'from-neutral-300 to-neutral-200' :
                'from-neutral-400 to-neutral-300'
              } ${
                photo.aspect === 'tall' ? 'h-72' :
                photo.aspect === 'wide' ? 'h-44' : 'h-56'
              }`}
            >
              <div class="text-center p-6">
                <Icon name="mdi:image-outline" class="w-12 h-12 text-neutral-400 mx-auto mb-2" />
                <p class="text-neutral-500 text-xs">Photo Coming Soon</p>
              </div>
            </div>

            <!-- Caption overlay -->
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end"
              x-show="hovered"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              x-cloak
            >
              <p class="text-white text-sm p-4 leading-tight font-medium">
                {photo.caption}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Upload CTA -->
      <div class="mt-16 bg-white rounded-2xl p-8 text-center border border-neutral-200">
        <Icon name="mdi:camera-plus-outline" class="w-12 h-12 text-brand-gold mx-auto mb-4" />
        <h3 class="font-display font-bold text-2xl text-neutral-900 mb-3">Share Your Memories</h3>
        <p class="text-neutral-600 leading-relaxed mb-6 max-w-md mx-auto">
          Were you at one of our events? We'd love to feature your photos in our gallery and share the joy with our community.
        </p>
        <a
          href="mailto:kidz4acure1993@gmail.com?subject=Photo Submission for Gallery"
          class="inline-flex items-center gap-2 bg-brand-red text-white font-semibold px-6 py-3 rounded-full hover:bg-brand-red-dark transition-colors"
        >
          <Icon name="mdi:email-outline" class="w-4 h-4" />
          Submit Photos
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  [x-cloak] { display: none !important; }
</style>
