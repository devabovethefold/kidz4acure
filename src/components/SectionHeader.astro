---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { title, subtitle, align = 'center', light = false } = Astro.props;
---

<div class={`mb-10 ${align === 'center' ? 'text-center' : 'text-left'}`}>
  <h2 class={`font-display font-bold text-3xl sm:text-4xl leading-tight ${light ? 'text-white' : 'text-neutral-900'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-3 text-lg max-w-2xl leading-relaxed ${align === 'center' ? 'mx-auto' : ''} ${light ? 'text-white/80' : 'text-neutral-600'}`}>
      {subtitle}
    </p>
  )}
  <div class={`mt-4 h-1 w-16 rounded-full bg-brand-gold ${align === 'center' ? 'mx-auto' : ''}`}></div>
</div>
